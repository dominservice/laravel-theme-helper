{
  "name": "dominservice/laravel-theme-helper",
  "description": "Manage Laravel themes, page metadata, hreflang, Schema.org JSON-LD, XML sitemaps and responsive image markup.",
  "type": "library",
  "keywords": ["laravel", "themes", "technical-seo", "hreflang", "json-ld", "sitemap"],
  "homepage": "https://github.com/dominservice/laravel-theme-helper",
  "license": "MIT",
  "authors": [
    {
      "name": "Mateusz Domin",
      "email": "biuro@dominsoftware.it",
      "homepage": "https://dominsoftware.it/"
    }
  ],
  "support": {
    "source": "https://github.com/dominservice/laravel-theme-helper",
    "issues": "https://github.com/dominservice/laravel-theme-helper/issues"
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "laravel/framework": "^13.32",
    "spatie/schema-org": "^5.0.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3"
  },
  "autoload": {
    "files": [
      "Helpers/helpers.php"
    ],
    "psr-4": {
      "Dominservice\\LaravelThemeHelper\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Dominservice\\LaravelThemeHelper\\ServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
